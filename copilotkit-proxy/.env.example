# URL base A2A. En Agent Runtime termina en /api/a2a/audio-search-journalists
# Ejemplo: https://us-east1-aiplatform.googleapis.com/reasoningEngines/v1/projects/PROJECT/locations/us-east1/reasoningEngines/ENGINE_ID/api/a2a/audio-search-journalists
A2A_AGENT_URL=

# Cloud Run privado que posee FAISS, CLAP y el dataset. El proxy lo invoca con
# un ID token de su propia service account; nunca se expone al navegador.
SEARCH_SERVICE_URL=

# Orígenes del widget, separados por comas. No usar * en producción.
ALLOWED_ORIGINS=http://localhost:5173
PORT=8080
