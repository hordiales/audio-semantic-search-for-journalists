# Retrieval service: owns PyTorch, CLAP, the sentence-transformers encoder and
# the FAISS indices. Deployed to Cloud Run, not to Agent Runtime.
FROM python:3.11-slim

RUN pip install --no-cache-dir uv==0.8.13

WORKDIR /code

COPY ./pyproject.toml ./README.md ./uv.lock ./
COPY ./src ./src

RUN uv sync --frozen --no-dev --no-group eval --group ml

RUN CKPT_DIR="$(echo /code/.venv/lib/python3.*/site-packages/laion_clap)" && \
    python -c "import sys, urllib.request; urllib.request.urlretrieve(sys.argv[1], sys.argv[2])" \
      "https://huggingface.co/lukewys/laion_clap/resolve/main/630k-audioset-best.pt" \
      "${CKPT_DIR}/630k-audioset-best.pt" && \
    test -s "${CKPT_DIR}/630k-audioset-best.pt"

ENV HF_HOME=/opt/hf-cache
RUN uv run --no-sync python -c "\
from sentence_transformers import SentenceTransformer; \
SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2')" && \
    chmod -R a+rX /opt/hf-cache

ARG COMMIT_SHA=""
ENV COMMIT_SHA=${COMMIT_SHA}

ARG AGENT_VERSION=0.0.0
ENV AGENT_VERSION=${AGENT_VERSION}

ENV OPENBLAS_NUM_THREADS=1
ENV OMP_NUM_THREADS=1
ENV CLAP_DEVICE=cpu
ENV MIN_SEGMENT_DURATION_SECONDS=5

EXPOSE 8080

CMD uv run --no-sync uvicorn src.search_service.app:app --host 0.0.0.0 --port ${PORT:-8080}
